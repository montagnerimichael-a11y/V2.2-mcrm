            statusKillNPC.Text = "⚠️ Sem espada!"
            statusKillNPC.TextColor3 = Color3.fromRGB(255, 200, 0)
            wait(2)
            return
        end
    end

    if not alvoNPC then
        alvoNPC = acharNPC()
        if alvoNPC then
            local nome = alvoNPC.Name or "NPC"
            statusKillNPC.Text = "🎯 " .. nome
            statusKillNPC.TextColor3 = Color3.fromRGB(255, 200, 0)
        else
            statusKillNPC.Text = "🔍 Procurando NPC..."
            statusKillNPC.TextColor3 = Color3.fromRGB(255, 200, 0)
            wait(1)
            return
        end
    end

    if alvoNPC and alvoNPC:FindFirstChild("Humanoid") and alvoNPC.Humanoid.Health > 0 then
        local hrp = alvoNPC:FindFirstChild("HumanoidRootPart")
        if hrp then
            local posAlvo = hrp.Position
            local posJogador = rootPart.Position
            local dist = (posAlvo - posJogador).Magnitude

            local cf = hrp.CFrame
            local costas = cf.LookVector * -1
            local posCostas = posAlvo + (costas * 2.5)

            if dist > 20 then
                local dir = (posAlvo - posJogador).Unit
                rootPart.CFrame = rootPart.CFrame + (dir * 10)
                statusKillNPC.Text = "🏃 Correndo..."
                statusKillNPC.TextColor3 = Color3.fromRGB(255, 200, 0)
                return
            end

            if dist > 4 then
                local dirCostas = (posCostas - posJogador).Unit
                rootPart.CFrame = rootPart.CFrame + (dirCostas * 5)
                statusKillNPC.Text = "🎯 Flanqueando..."
                statusKillNPC.TextColor3 = Color3.fromRGB(255, 200, 0)
                return
            end

            local olhar = CFrame.lookAt(rootPart.Position, posAlvo)
            rootPart.CFrame = CFrame.new(rootPart.Position, olhar.LookVector + rootPart.Position)

            pcall(function()
                espada:Activate()
                wait(0.05)
                espada:Activate()
                usarPoderes()
            end)

            killsNPC = killsNPC + 1
            killsNPCLabel.Text = "🧟 Kills NPC: " .. killsNPC
            statusKillNPC.Text = "🧟 ATACANDO!"
            statusKillNPC.TextColor3 = Color3.fromRGB(100, 255, 100)
        end
    else
        alvoNPC = nil
        statusKillNPC.Text = "💀 NPC Morto!"
        statusKillNPC.TextColor3 = Color3.fromRGB(255, 100, 100)
    end
end

function alternarKillNPC()
    if not vivo() then
        statusKillNPC.Text = "⚠️ Morto!"
        statusKillNPC.TextColor3 = Color3.fromRGB(255, 200, 0)
        wait(1)
        statusKillNPC.Text = "🔴 OFF"
        statusKillNPC.TextColor3 = Color3.fromRGB(255, 100, 100)
        return
    end

    matandoNPC = not matandoNPC

    if matandoNPC then
        espada = acharEspada("sword")
        if not espada then
            statusKillNPC.Text = "⚠️ Sem espada!"
            statusKillNPC.TextColor3 = Color3.fromRGB(255, 200, 0)
            matandoNPC = false
            btnKillNPC.Text = "🧟 ATIVAR NPC"
            btnKillNPC.BackgroundColor3 = Color3.fromRGB(100, 200, 100)
            wait(2)
            statusKillNPC.Text = "🔴 OFF"
            statusKillNPC.TextColor3 = Color3.fromRGB(255, 100, 100)
            return
        end

        btnKillNPC.Text = "⏹ PARAR NPC"
        btnKillNPC.BackgroundColor3 = Color3.fromRGB(200, 100, 100)
        statusKillNPC.Text = "🟢 ON"
        statusKillNPC.TextColor3 = Color3.fromRGB(100, 255, 100)
        alvoNPC = nil

        if loopKillNPC then loopKillNPC:Disconnect() end
        loopKillNPC = RunService.Heartbeat:Connect(function()
            if matandoNPC then
                loopKillNPCFunc()
                wait(0.05)
            end
        end)
    else
        btnKillNPC.Text = "🧟 ATIVAR NPC"
        btnKillNPC.BackgroundColor3 = Color3.fromRGB(100, 200, 100)
        statusKillNPC.Text = "🔴 OFF"
        statusKillNPC.TextColor3 = Color3.fromRGB(255, 100, 100)
        alvoNPC = nil

        if loopKillNPC then
            loopKillNPC:Disconnect()
            loopKillNPC = nil
        end
    end
end

