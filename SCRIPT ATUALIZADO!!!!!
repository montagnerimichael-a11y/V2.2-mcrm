local function criarAuraInimigo(alvo)
    if not alvo or not alvo.Character then return end
    
    local char = alvo.Character
    local hrp = char:FindFirstChild("HumanoidRootPart")
    if not hrp then return end
    
    if auras[alvo] then return end
    
    local aura = Instance.new("Part")
    aura.Size = Vector3.new(hitboxRaio * 2, 0.3, hitboxRaio * 2)
    aura.Position = hrp.Position
    aura.Anchored = true
    aura.CanCollide = false
    aura.Transparency = 0.75
    aura.BrickColor = BrickColor.new("Bright red")
    aura.Material = Enum.Material.Neon
    aura.Parent = workspace
    
    auras[alvo] = aura
    
    local followConnection
    followConnection = RunService.Heartbeat:Connect(function()
        if not alvo or not alvo.Character or not alvo.Character:FindFirstChild("HumanoidRootPart") then
            if aura then aura:Destroy() end
            auras[alvo] = nil
            if followConnection then followConnection:Disconnect() end
            return
        end
        local hrp2 = alvo.Character:FindFirstChild("HumanoidRootPart")
        if hrp2 then
            aura.Position = hrp2.Position
            aura.CFrame = CFrame.new(hrp2.Position)
        end
    end)
end

local function removerAuras()
    for _, aura in pairs(auras) do
        pcall(function() aura:Destroy() end)
    end
    auras = {}
end

local function criarHitboxJogador()
    if hitboxPart then
        hitboxPart:Destroy()
        hitboxPart = nil
    end
    
    if not character or not rootPart then return end
    
    hitboxPart = Instance.new("Part")
    hitboxPart.Size = Vector3.new(hitboxRaio * 2, 6, hitboxRaio * 2)
    hitboxPart.Position = rootPart.Position
    hitboxPart.Anchored = true
    hitboxPart.CanCollide = false
    hitboxPart.Transparency = 1
    hitboxPart.Name = "HitboxExpanded"
    hitboxPart.Parent = character
    
    local followConnection
    followConnection = RunService.Heartbeat:Connect(function()
        if not hitboxExpandido or not character or not rootPart then
            if hitboxPart then hitboxPart:Destroy() end
            if followConnection then followConnection:Disconnect() end
            return
        end
        if hitboxPart then
            hitboxPart.Position = rootPart.Position
        end
    end)
end

local function ativarHitbox()
    if hitboxExpandido then return end
    hitboxExpandido = true
    
    print("🎯 Hitbox expandido ativado! Raio: " .. hitboxRaio)
    
    criarHitboxJogador()
    
    if loopHitbox then loopHitbox:Disconnect() end
    loopHitbox = RunService.Heartbeat:Connect(function()
        if not hitboxExpandido then return end
        
        local alvos = {}
        
        for _, jogador in pairs(Players:GetPlayers()) do
            if jogador ~= player then
                local c = jogador.Character
                if c and c:FindFirstChild("Humanoid") and c.Humanoid.Health > 0 then
                    local hrp = c:FindFirstChild("HumanoidRootPart")
                    if hrp then
                        local dist = (hrp.Position - rootPart.Position).Magnitude
                        if dist < 300 then
                            table.insert(alvos, jogador)
                        end
                    end
                end
            end
        end
        
        for _, obj in pairs(workspace:GetDescendants()) do
            if obj:IsA("Model") and obj:FindFirstChild("Humanoid") and obj.Humanoid.Health > 0 then
                local isPlayer = false
                for _, p in pairs(Players:GetPlayers()) do
                    if p.Character == obj then
                        isPlayer = true
                        break
                    end
                end
                if not isPlayer then
                    local hrp = obj:FindFirstChild("HumanoidRootPart")
                    if hrp then
                        local dist = (hrp.Position - rootPart.Position).Magnitude
                        if dist < 300 then
                            table.insert(alvos, obj)
                        end
                    end
                end
            end
        end
        
        for _, alvo in pairs(alvos) do
            if not auras[alvo] then
                criarAuraInimigo(alvo)
            end
        end
        
        for alvo, aura in pairs(auras) do
            local stillAlive = false
            for _, a in pairs(alvos) do
                if a == alvo then
                    stillAlive = true
                    break
                end
            end
            if not stillAlive then
                pcall(function() aura:Destroy() end)
                auras[alvo] = nil
            end
        end
    end)
    
    if btnHitbox then
        btnHitbox.Text = "⏹ PARAR HITBOX"
        btnHitbox.BackgroundColor3 = Color3.fromRGB(200, 50, 50)
    end
    if statusHitbox then
        statusHitbox.Text = "🟢 ON"
        statusHitbox.TextColor3 = Color3.fromRGB(0, 255, 100)
    end
end

local function desativarHitbox()
    if not hitboxExpandido then return end
    hitboxExpandido = false
    
    if loopHitbox then
        loopHitbox:Disconnect()
        loopHitbox = nil
    end
    
    removerAuras()
    
    if hitboxPart then
        hitboxPart:Destroy()
        hitboxPart = nil
    end
    
    if character then
        local oldHitbox = character:FindFirstChild("HitboxExpanded")
        if oldHitbox then
            oldHitbox:Destroy()
        end
    end
    
    print("🎯 Hitbox desativado! Voltou ao normal.")
    
    if btnHitbox then
        btnHitbox.Text = "🎯 ATIVAR HITBOX"
        btnHitbox.BackgroundColor3 = Color3.fromRGB(100, 100, 100)
    end
    if statusHitbox then
        statusHitbox.Text = "🔴 OFF"
        statusHitbox.TextColor3 = Color3.fromRGB(255, 100, 100)
    end
end

local function alternarHitbox()
    if hitboxExpandido then
        desativarHitbox()
    else
        ativarHitbox()
    end
end

local function resetarHitbox()
    if hitboxExpandido then
        desativarHitbox()
    end
    hitboxRaio = 15
    if hitboxRaioLabel then
        hitboxRaioLabel.Text = "📏 Raio: " .. hitboxRaio
    end
    if hitboxRaioValor then
        hitboxRaioValor.Text = hitboxRaio
    end
    print("🎯 Hitbox resetado para: " .. hitboxRaio)
end

local function aumentarHitboxRaio()
    if hitboxRaio < 50 then
        hitboxRaio = hitboxRaio + 2
        if hitboxRaioLabel then
            hitboxRaioLabel.Text = "📏 Raio: " .. hitboxRaio
        end
        if hitboxRaioValor then
            hitboxRaioValor.Text = hitboxRaio
        end
        print("🎯 Hitbox raio: " .. hitboxRaio)
        if hitboxExpandido then
            desativarHitbox()
            ativarHitbox()
        end
    end
end

local function diminuirHitboxRaio()
    if hitboxRaio > 5 then
        hitboxRaio = hitboxRaio - 2
        if hitboxRaioLabel then
            hitboxRaioLabel.Text = "📏 Raio: " .. hitboxRaio
        end
        if hitboxRaioValor then
            hitboxRaioValor.Text = hitboxRaio
        end
        print("🎯 Hitbox raio: " .. hitboxRaio)
        if hitboxExpandido then
            desativarHitbox()
            ativarHitbox()
        end
    end
end

