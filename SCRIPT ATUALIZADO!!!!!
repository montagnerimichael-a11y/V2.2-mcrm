local function antiAFKFunc()
    if not antiAFKAtivo then return end
    if not vivo() then return end
    
    print("🛡️ Anti-AFK executando...")
    
    local direcoes = {
        Vector3.new(2, 0, 0),
        Vector3.new(-2, 0, 0),
        Vector3.new(0, 0, 2),
        Vector3.new(0, 0, -2)
    }
    local dir = direcoes[math.random(1, #direcoes)]
    
    pcall(function()
        rootPart.CFrame = rootPart.CFrame + dir
    end)
    
    local teclas = {"W", "A", "S", "D", "Space"}
    local tecla = teclas[math.random(1, #teclas)]
    pcall(function()
        VirtualInputManager:SendKeyEvent(true, tecla, false, game)
        wait(0.05)
        VirtualInputManager:SendKeyEvent(false, tecla, false, game)
    end)
    
    pcall(function()
        humanoid.Jump = true
        wait(0.1)
        humanoid.Jump = false
    end)
    
    afkContador = afkContador + 1
    print("🛡️ Anti-AFK executado! (" .. afkContador .. "x)")
end

local function alternarAntiAFK()
    antiAFKAtivo = not antiAFKAtivo
    
    if antiAFKAtivo then
        btnAntiAFK.Text = "🛡️ ANTI-AFK: ON"
        btnAntiAFK.BackgroundColor3 = Color3.fromRGB(0, 200, 100)
        statusAntiAFK.Text = "🟢 Ativo"
        statusAntiAFK.TextColor3 = Color3.fromRGB(0, 255, 100)
        
        antiAFKFunc()
        ultimoMovimento = tick()
        
        if loopAntiAFK then loopAntiAFK:Disconnect() end
        loopAntiAFK = RunService.Heartbeat:Connect(function()
            if tick() - ultimoMovimento > math.random(45, 90) then
                antiAFKFunc()
                ultimoMovimento = tick()
            end
        end)
        print("🛡️ Anti-AFK ATIVADO!")
    else
        btnAntiAFK.Text = "🛡️ ANTI-AFK: OFF"
        btnAntiAFK.BackgroundColor3 = Color3.fromRGB(100, 100, 100)
        statusAntiAFK.Text = "🔴 Inativo"
        statusAntiAFK.TextColor3 = Color3.fromRGB(255, 100, 100)
        
        if loopAntiAFK then
            loopAntiAFK:Disconnect()
            loopAntiAFK = nil
        end
        print("🛡️ Anti-AFK DESATIVADO!")
    end
end

