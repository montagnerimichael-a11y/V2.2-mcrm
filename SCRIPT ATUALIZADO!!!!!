-- SISTEMA DE OTIMIZAÇÃO GRÁFICA
-- ============================================

local function salvarConfiguracoesOriginais()
    qualidadeOriginal = {
        brightness = Lighting.Brightness,
        clockTime = Lighting.ClockTime,
        fogEnd = Lighting.FogEnd,
        fogStart = Lighting.FogStart,
        globalShadows = Lighting.GlobalShadows,
        ambient = Lighting.Ambient,
        outdoorAmbient = Lighting.OutdoorAmbient,
        exposureCompensation = Lighting.ExposureCompensation
    }
end

local function otimizarGraficos()
    if otimizacaoAtiva then
        if qualidadeOriginal.brightness then
            Lighting.Brightness = qualidadeOriginal.brightness
            Lighting.ClockTime = qualidadeOriginal.clockTime
            Lighting.FogEnd = qualidadeOriginal.fogEnd
            Lighting.FogStart = qualidadeOriginal.fogStart
            Lighting.GlobalShadows = qualidadeOriginal.globalShadows
            Lighting.Ambient = qualidadeOriginal.ambient
            Lighting.OutdoorAmbient = qualidadeOriginal.outdoorAmbient
            Lighting.ExposureCompensation = qualidadeOriginal.exposureCompensation
        end
        pcall(function()
            for _, obj in pairs(workspace:GetDescendants()) do
                if obj:IsA("BasePart") and obj:GetAttribute("MaterialOriginal") then
                    obj.Material = Enum.Material[obj:GetAttribute("MaterialOriginal")]
                    obj:SetAttribute("MaterialOriginal", nil)
                end
            end
        end)
        otimizacaoAtiva = false
        print("🔄 Gráficos restaurados!")
    else
        salvarConfiguracoesOriginais()
        Lighting.Brightness = 2
        Lighting.ClockTime = 14
        Lighting.FogEnd = 100000
        Lighting.FogStart = 50000
        Lighting.GlobalShadows = false
        Lighting.Ambient = Color3.fromRGB(180, 180, 180)
        Lighting.OutdoorAmbient = Color3.fromRGB(160, 160, 160)
        Lighting.ExposureCompensation = 0.2
        pcall(function()
            for _, obj in pairs(workspace:GetDescendants()) do
                if obj:IsA("BasePart") then
                    obj:SetAttribute("MaterialOriginal", obj.Material.Name)
                    if obj.Material == Enum.Material.Grass or obj.Material == Enum.Material.Fabric or obj.Material == Enum.Material.WoodPlanks or obj.Material == Enum.Material.Cobblestone then
                        obj.Material = Enum.Material.SmoothPlastic
                        texturasRemovidas = texturasRemovidas + 1
                    end
                    if obj.Reflectance > 0 then obj.Reflectance = 0 end
                end
                if obj:IsA("ParticleEmitter") then obj.Enabled = false end
                if obj:IsA("Texture") or obj:IsA("Decal") then obj.Transparency = 0.5 end
            end
        end)
        otimizacaoAtiva = true
        print("⚡ Otimização gráfica ativada! Texturas: "..texturasRemovidas)
    end
end

local function otimizarExtremo()
    Lighting.Brightness = 2
    Lighting.GlobalShadows = false
    Lighting.FogEnd = 100000
    Lighting.FogStart = 50000
    pcall(function()
        for _, obj in pairs(workspace:GetDescendants()) do
            if obj:IsA("BasePart") then
                obj.Material = Enum.Material.SmoothPlastic
                obj.Reflectance = 0
                obj.CastShadow = false
            elseif obj:IsA("ParticleEmitter") then
                obj.Enabled = false
            elseif obj:IsA("Texture") or obj:IsA("Decal") then
                obj:Destroy()
            elseif obj:IsA("SpecialMesh") then
                obj.TextureId = ""
            end
        end
    end)
    print("🔥 Otimização EXTREMA ativada!")
end

