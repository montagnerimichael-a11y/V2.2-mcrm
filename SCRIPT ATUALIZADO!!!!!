        pararFly()
        btnFly.Text = "🕊️ FLY: OFF"
        btnFly.BackgroundColor3 = Color3.fromRGB(100, 100, 100)
        statusFly.Text = "🔴 Inativo"
        statusFly.TextColor3 = Color3.fromRGB(255, 100, 100)
    else
        iniciarFly()
        btnFly.Text = "🕊️ FLY: ON"
        btnFly.BackgroundColor3 = Color3.fromRGB(0, 200, 100)
        statusFly.Text = "🟢 Ativo"
        statusFly.TextColor3 = Color3.fromRGB(0, 255, 100)
    end
end)

