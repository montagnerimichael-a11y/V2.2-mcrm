-- LOOP DE PERFORMANCE
-- ============================================

local ultimoFPS = tick()
local frames = 0

RunService.Heartbeat:Connect(function()
    frames = frames + 1
    if tick() - ultimoFPS >= 1 then
        local fps = frames
        frames = 0
        ultimoFPS = tick()

        if fps > 50 then
            performance.Text = "⚡ Performance: Excelente ("..fps.." FPS)"
            performance.TextColor3 = Color3.fromRGB(0, 255, 100)
        elseif fps > 30 then
            performance.Text = "⚡ Performance: Boa ("..fps.." FPS)"
            performance.TextColor3 = Color3.fromRGB(255, 200, 0)
        else
            performance.Text = "⚡ Performance: Baixa ("..fps.." FPS)"
            performance.TextColor3 = Color3.fromRGB(255, 100, 100)
        end
    end

    if vivo() then
        statusVivo.Text = "❤️"
        statusVivo.TextColor3 = Color3.fromRGB(0, 255, 100)
        if not coletandoSouls then
            local total = contarSouls()
            if total > 0 then
                orbesDetect.Text = "🟢 Souls: "..total
                orbesDetect.TextColor3 = Color3.fromRGB(0, 255, 100)
            else
                orbesDetect.Text = "🔴 Souls: 0"
                orbesDetect.TextColor3 = Color3.fromRGB(255, 100, 100)
            end
        end
    else
        statusVivo.Text = "💀"
        statusVivo.TextColor3 = Color3.fromRGB(255, 50, 50)
    end

    if matandoLava and vivo() then
        local agora = tick()
        local vulcaoStatus = (cargaVulcao >= cargaMaxima and agora - ultimoUsoVulcao > tempoCooldownVulcao) and "✅ PRONTO" or "⏳ " .. cargaVulcao .. "/" .. cargaMaxima
        local explosaoStatus = (agora - ultimoUsoExplosao > tempoCooldownExplosao) and "✅ PRONTO" or "⏳ " .. math.floor(tempoCooldownExplosao - (agora - ultimoUsoExplosao)) .. "s"
        local formaStatus = (agora - ultimoUsoForma > tempoCooldownForma) and "✅ PRONTO" or "⏳ " .. math.floor(tempoCooldownForma - (agora - ultimoUsoForma)) .. "s"
        habilidadesLabel.Text = "💥 Explosão: " .. explosaoStatus .. "  |  🔥 Forma: " .. formaStatus
    end
end)

