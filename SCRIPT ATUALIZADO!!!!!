local function definirVelocidade(novaVelocidade)
    velocidadeAtual = math.clamp(novaVelocidade, velocidadeMinima, velocidadeMaxima)
    if humanoid then humanoid.WalkSpeed = velocidadeAtual end
    if velocidadeAtual > 16 then
        if loopVelocidade then loopVelocidade:Disconnect() end
        loopVelocidade = RunService.Heartbeat:Connect(function()
            if humanoid and humanoid.Health > 0 then
                if humanoid.WalkSpeed ~= velocidadeAtual then
                    humanoid.WalkSpeed = velocidadeAtual
                end
            end
        end)
    else
        if loopVelocidade then loopVelocidade:Disconnect() loopVelocidade = nil end
        if humanoid then humanoid.WalkSpeed = 16 end
    end
end

local function aumentarVelocidade()
    definirVelocidade(velocidadeAtual + 10)
    print("🏃 Velocidade: " .. velocidadeAtual)
end

local function diminuirVelocidade()
    definirVelocidade(velocidadeAtual - 10)
    print("🏃 Velocidade: " .. velocidadeAtual)
end

local function resetarVelocidade()
    definirVelocidade(16)
    print("🏃 Velocidade resetada para: 16")
end

