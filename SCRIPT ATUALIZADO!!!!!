local function iniciarFly()
    if flyAtivo then return end
    if not character or not rootPart then return end

    flyAtivo = true
    print("🕊️ Fly ativado! Velocidade: " .. flySpeed)

    flyBodyVelocity = Instance.new("BodyVelocity")
    flyBodyVelocity.MaxForce = Vector3.new(1e6, 1e6, 1e6)
    flyBodyVelocity.Velocity = Vector3.new(0, 0, 0)
    flyBodyVelocity.Parent = rootPart

    flyBodyGyro = Instance.new("BodyGyro")
    flyBodyGyro.MaxTorque = Vector3.new(1e6, 1e6, 1e6)
    flyBodyGyro.CFrame = rootPart.CFrame
    flyBodyGyro.Parent = rootPart

    if loopFly then loopFly:Disconnect() end
    loopFly = RunService.Heartbeat:Connect(function()
        if not flyAtivo or not rootPart then return end

        local moveDirection = Vector3.new(0, 0, 0)
        local camera = workspace.CurrentCamera
        
        if camera then
            local forward = camera.CFrame.LookVector
            local right = camera.CFrame.RightVector

            if UserInputService:IsKeyDown(Enum.KeyCode.W) then
                moveDirection = moveDirection + Vector3.new(forward.X, 0, forward.Z).Unit
            end
            if UserInputService:IsKeyDown(Enum.KeyCode.S) then
                moveDirection = moveDirection - Vector3.new(forward.X, 0, forward.Z).Unit
            end
            if UserInputService:IsKeyDown(Enum.KeyCode.A) then
                moveDirection = moveDirection - Vector3.new(right.X, 0, right.Z).Unit
            end
            if UserInputService:IsKeyDown(Enum.KeyCode.D) then
                moveDirection = moveDirection + Vector3.new(right.X, 0, right.Z).Unit
            end
            if UserInputService:IsKeyDown(Enum.KeyCode.Space) then
                moveDirection = moveDirection + Vector3.new(0, 1, 0)
            end
            if UserInputService:IsKeyDown(Enum.KeyCode.LeftShift) then
                moveDirection = moveDirection + Vector3.new(0, -1, 0)
            end
        end

        if moveDirection.Magnitude > 0 then
            moveDirection = moveDirection.Unit
            flyBodyVelocity.Velocity = moveDirection * flySpeed
        else
            flyBodyVelocity.Velocity = Vector3.new(0, 0, 0)
        end

        flyBodyGyro.CFrame = CFrame.new(rootPart.Position, rootPart.Position + Vector3.new(0, -1, 0))
    end)
end

local function pararFly()
    if not flyAtivo then return end
    flyAtivo = false
    print("🕊️ Fly desativado!")

    if flyBodyVelocity then
        flyBodyVelocity:Destroy()
        flyBodyVelocity = nil
    end
    if flyBodyGyro then
        flyBodyGyro:Destroy()
        flyBodyGyro = nil
    end
    if loopFly then
        loopFly:Disconnect()
        loopFly = nil
    end
end

local function aumentarFlySpeed()
    flySpeed = math.min(flySpeed + flyIncrement, flyMaxSpeed)
    if flySpeedLabel then flySpeedLabel.Text = "🕊️ Fly: " .. flySpeed end
    print("🕊️ Fly velocidade: " .. flySpeed)
end

local function diminuirFlySpeed()
    flySpeed = math.max(flySpeed - flyIncrement, flyMinSpeed)
    if flySpeedLabel then flySpeedLabel.Text = "🕊️ Fly: " .. flySpeed end
    print("🕊️ Fly velocidade: " .. flySpeed)
end

local function resetarFlySpeed()
    flySpeed = 50
    if flySpeedLabel then flySpeedLabel.Text = "🕊️ Fly: " .. flySpeed end
    print("🕊️ Fly resetado para: 50")
end

