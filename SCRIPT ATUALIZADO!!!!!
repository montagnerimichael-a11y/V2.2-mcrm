function vivo()
    return character and character.Parent and humanoid and humanoid.Health > 0
end

function classificarObjeto(nome)
    nome = nome:lower()
    if nome:find("diamond") or nome:find("diamante") or nome:find("gem") or nome:find("crystal") then
        return "diamante"
    end
    if (nome:find("soul") or nome:find("alma") or nome:find("espirito") or nome:find("orb") or nome:find("esfera")) then
        return "soul"
    end
    return nil
end

function acharEspada(nomeEspada)
    if character then
        for _, obj in pairs(character:GetChildren()) do
            if obj:IsA("Tool") then
                local nome = obj.Name:lower()
                if nome:find(nomeEspada or "sword") or nome:find("espada") or nome:find("katana") or nome:find("blade") then
                    return obj
                end
            end
        end
    end
    return nil
end

function acharEspadaLava()
    if character then
        for _, obj in pairs(character:GetChildren()) do
            if obj:IsA("Tool") then
                local nome = obj.Name:lower()
                if nome:find("lava") or nome:find("espada de lava") or nome:find("lava sword") then
                    espadaLava = obj
                    return espadaLava
                end
            end
        end
    end
    return nil
end

function acharAlvo()
    if not vivo() then return nil end
    local pos = rootPart.Position
    local melhor = nil
    local menorDistancia = 200

    for _, jogador in pairs(Players:GetPlayers()) do
        if jogador ~= player then
            local c = jogador.Character
            if c and c:FindFirstChild("Humanoid") and c.Humanoid.Health > 0 then
                local hrp = c:FindFirstChild("HumanoidRootPart")
                if hrp then
                    local d = (hrp.Position - pos).Magnitude
                    if d < menorDistancia then
                        menorDistancia = d
                        melhor = jogador
                    end
                end
            end
        end
    end
    return melhor
end

function acharNPC()
    if not vivo() then return nil end
    local pos = rootPart.Position
    local melhor = nil
    local menorDistancia = 200

    for _, obj in pairs(workspace:GetDescendants()) do
        if obj:IsA("Model") then
            local hum = obj:FindFirstChild("Humanoid")
            if hum and hum.Health > 0 then
                local isPlayer = false
                for _, p in pairs(Players:GetPlayers()) do
                    if p.Character == obj then
                        isPlayer = true
                        break
                    end
                end
                if not isPlayer then
                    local hrp = obj:FindFirstChild("HumanoidRootPart")
                    if hrp then
                        local d = (hrp.Position - pos).Magnitude
                        if d < menorDistancia then
                            menorDistancia = d
                            melhor = obj
                        end
                    end
                end
            end
        end
    end
    return melhor
end

function acharBoss()
    if not vivo() then return nil end
    local pos = rootPart.Position
    local melhor = nil
    local menorDistancia = 300

    for _, obj in pairs(workspace:GetDescendants()) do
        if obj:IsA("Model") then
            local hum = obj:FindFirstChild("Humanoid")
            if hum and hum.Health > 0 then
                local nome = obj.Name:lower()
                local isBoss = nome:find("boss") or nome:find("chef") or nome:find("lord") or nome:find("king") or nome:find("dragon")
                local isPlayer = false
                for _, p in pairs(Players:GetPlayers()) do
                    if p.Character == obj then
                        isPlayer = true
                        break
                    end
                end
                if not isPlayer and isBoss then
                    local hrp = obj:FindFirstChild("HumanoidRootPart")
                    if hrp then
                        local d = (hrp.Position - pos).Magnitude
                        if d < menorDistancia then
                            menorDistancia = d
                            melhor = obj
                        end
                    end
                end
            end
        end
    end
    return melhor
end

function contarSouls()
    local count = 0
    local pos = rootPart.Position
    for _, obj in pairs(cacheObjetos) do
        if obj:IsA("BasePart") and classificarObjeto(obj.Name) == "soul" then
            local d = (obj.Position - pos).Magnitude
            if d < raio + 100 then
                count = count + 1
            end
        end
    end
    return count
end

